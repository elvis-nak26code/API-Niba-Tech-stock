# Copiez ce fichier vers .env et adaptez les valeurs.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# URI de connexion MongoDB (local ou Atlas).
# Utilisez « memory » pour un MongoDB embarqué sans serveur installé.
MONGODB_URI=mongodb://127.0.0.1:27017/nibatech
# Version utilisée uniquement en mode « memory ».
MONGODB_VERSION=7.0.14

# Jeton de signature JWT (à changer impérativement en production)
JWT_SECRET=changez-moi-super-secret-niba-tech
JWT_EXPIRES_IN=7d

# Origines autorisées pour CORS (séparées par des virgules)
# Le web tourne sur http://localhost:5173 et le desktop sur http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Compte de la PLATEFORME d'administration (exploitant), cree au premier
# demarrage si aucun n'existe pas. Distinct des comptes de l'application.
# A changer des le premier usage si l'API est exposee sur Internet.
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=admin1234

# Comptes de démonstration supplémentaires
SEED_DEMO=true