NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# 'memory' = MongoDB embarqué (mongodb-memory-server, aucun mongod requis).
# Mettre une URI réelle en production (ex. mongodb+srv://user:pass@cluster/…).
MONGODB_URI=memory
MONGODB_VERSION=7.0.14
JWT_SECRET=niba-tech-dev-secret-2026-change-in-prod
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DEFAULT_ADMIN_EMAIL=admin@nibatech.com
DEFAULT_ADMIN_PASSWORD=admin123
SEED_DEMO=true